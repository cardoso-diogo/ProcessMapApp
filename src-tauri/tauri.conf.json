{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Process Map Builder",
  "version": "1.1.0",
  "identifier": "com.processmapbuilder.desktop",
  "build": {
    "frontendDist": "../app"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Process Map Builder",
        "width": 1440,
        "height": 900,
        "minWidth": 800,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "category": "Productivity",
    "shortDescription": "Create and export layered process maps",
    "longDescription": "Offline desktop application for creating, editing and exporting layered process maps.",
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
